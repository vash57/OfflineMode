# OfflineMode configuration sample.
# Copy this file to `.env` and adjust the values for your machine.
# Never commit your real `.env` file.

# Where your local Ollama server is listening.
# - Normal Windows Ollama install: http://127.0.0.1:11434
# - Inside WSL2, the Windows host is reached through the WSL default gateway.
#   Find the current gateway with:  ip route | awk '/default/{print $3}'
OLLAMA_BASE_URL=http://172.22.224.1:11434

# Local model already available in Ollama (checked with: ollama list).
# The project is built and tested with gemma4:e2b.
OLLAMA_MODEL=gemma4:e2b

# The web app binds to loopback only, so it is not exposed to the network.
APP_HOST=127.0.0.1
APP_PORT=8080